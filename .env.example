# If API runs on host and DB runs in Docker, keep DB_HOST=localhost.
# If API runs in Docker Compose, DB_HOST is set automatically to service name: postgres.
# LAN_BIND_IP must be your host LAN IP (example 192.168.1.20); the API binds only to that address.
# DB_BIND_IP must be your host LAN IP when remote tools (e.g., Power BI) need DB access.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=musicdb
DB_USER=yorch
DB_PASSWORD=Y0rch8mN2qLp7sTx
LAN_BIND_IP=192.168.1.20
DB_BIND_IP=192.168.1.20
